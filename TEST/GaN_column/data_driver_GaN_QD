***************************************************************************
*
*                             SUPERCELL INPUT
*
***************************************************************************

# super basis input flag : --> FALSE  - build the super basis
#	                   --> TRUE   - read the super basis

super basis flag = F
super basis file = 'SiO2_basis.dat'

extra couplings flag  =  F

############## chemical input : materials involved

# total number of materials in the supercell ( including the frame )

number of materials = 2

#---- material 1 ( supercell frame )

material 1 name = 'GaN'	
material 1 type = 'binary'
parent file 1 in material 1 = '../../bulk/GaN_wz.data'
extra couplings in material 1 =  F

material 2 name = 'AlGaN'	
material 2 type = 'ternary'
parent file 2 in material 2 = '../../bulk/GaN_wz.data'
parent file 1 in material 2 = '../../bulk/AlN_wz.data'
extra couplings in material 2 =  F

content of parent 2 in material 2 = 0.80
VCA disorder in material 2 = 0.0
### VCA disorder is related to bowing factor for gap , etc.  ( greater disorder -> greater bow -> higher gap)

############ geometry input

Rotation along (111) = T 

supercell start = -40.0000  -45.7239   -3.0000
supercell end =    40.0000   45.7239   86.0000

# materials shape files

shape file 2 = 'basis_hex_coord.dat'

# supercell orientation : in terms of Miller indeces

supercell orientation

 1  1  0
-1  1  0
 0  0  1

# Created more complex structure hetrostructure freestanding structure etc.
structure building flag = T
str_filename = 'struct1.input'
str_output = T
str_filename_out = 'struct'

# Load pre-constructed structure 
load precon flag = F
gen_filename = 'wire_7.gen'
nr_atomtypes = 2
use str file = F
gen_str_filename = 'struct.input'
nn_max_dist = 2.5D0

***************************************************************************
*
*                          TIGHT BINDING INPUT
*
***************************************************************************

# coupling order
nearest neighbours order = 1

# coupling scaling
ETB coupling scaling = T
nearest distance accuracy (%) = 2.0D0

ETB onsite shift = F 

# spin - orbit
relativistic = T

random alloy = F
number of alloy loops = 2

# surface boundaries
periodic boundaries = 'no'

# saturated bond ETB parameters
saturated bond scaling = 0.1D0
saturated onsite energy = -50.0D0

# Brillouin zone sampling
k vector file = './k_points.in'

# reference orbitals
state file = 'state.dat'


***************************************************************************
*
*                            STRUCTURE OUTPUT
*
***************************************************************************

output flag = 0
xmol output = F 
xmol output file = 'GaN_basis.dat'
xyz output file = 'GaN_basis.xyz'

basis output = T
basis output file = 'GaN_basis_coord.dat'

gen output = T

**************************************************************************
*
*                               STRAIN
*
**************************************************************************

strain = F 
strain tensor = F
strain type = 'read'
strain file = 'displacements.out'

Quantum Well =  F
QW start = 50.0d0
QW end = 85.0d0

strain monodim  = F

internal strain = F
internal strain file = 'QW_int_strain.dat'

potential = F
potential file = 'column.dat'


***************************************************************************
*
*                          SPARSE INDEX INPUT
*
***************************************************************************

# upper / lower / full

sparse format = 'full'
sparse index file = 'indeces_sparse.dat'
sparse values file = 'values_sparse.dat'

***************************************************************************
*
*                         DIAGONALIZATION INPUT
*
***************************************************************************
save CSR matrix = F

diagonalization = T

# lanczos / davidson

diagonalization method = 'lanczos'

#LAPACK
max number of eigenvalues = 160
number of valence states = 4
min energy = -100.0
max energy = 100

# Fast Lanczos
fast lanczos flag = T 
number of fast lanczos iterations = 2
min number of lanczos iterations = 30
max number of lanczos iterations = 1000
orthogonality tolerance = 1.0d-5
fast tolerance = 1.0d-1
long tolerance = 1.0d-10

# Standard Lanczos
standard lanczos flag = F
number of lanczos iterations = 50
standard tolerance = 1.0d-10

# davidson

# number of values = is better = size of ham.
number of values = 160 
maximum number of iterations = 100000
tolerance = 1.0d-5
guess energy value = ( 0.0D0, 0.0D0 )

# lanczos
conduction = F 
number of cond values = 1 
conduction guess = 3.0D0 3.0D0
conduction result = F 
conduction result file = 'result_cond.dat'

valence = T
number of valence values = 1 
valence guess = 0.5d0 0.5d0
valence result = T
valence result file = 'result_val.dat'

# result syntax for the eigen values file :
# --> 0 = band gap  :  norm of k   - valence energy ( error ) - conduction energy ( error ) - gap ( error )
# --> 1 = alloys    :  alloy conc  - valence energy ( error ) - conduction energy ( error ) - gap ( error )
# --> 2 = band structure :  norm of k  - energy for all the bands ( OK only for the bulk !!! and only for davidson !!!)

result format = 2

eigenvalues file = 'GaN_eigv.dat'

# result syntax for the eigen vectors file :
# index of the atom / charge density for valence ( raw + normalized ) 
# / charge density for conduction ( raw + normalized )
eigenstates = T
# eigenstates = FALSE  per  bulk  energies dispersion
eigenstates file = 'GaN_vec.dat'

#Optical calculations
#Notice that eigenvalues are needed for these calculations

#Activate calculation of optical properties 
optics = T

#Intra band optical elements are to be calculated
intra_band_optics = T

#Inter band optical elements are to be calculated
inter_band_optics = T




