# sp3s*d model
# Jancu optimized  for  m*
#

 $subject
 compound_name = 'Si'
 comment = 'sp3s*d'
 $end

 $lattice
 prim1 = 
    2.7150      2.7150      0.0000 
 prim2 = 
    0.0000      2.7150      2.7150 
 prim3 =
    2.7150      0.0000      2.7150

 fuzzyequal=.false.
 accuracy = 1.0
 prim_lattice_cosy=.true.

 basis_name(1)='Si'
 basis_name(2)='Si'

 basis =
     0.0    0.0     0.0
   0.250  0.250   0.250
 $end

 $states_and_couplings

 relativistic=.false.

 state_name(1)='s'
 state_name(2)='px'
 state_name(3)='py'
 state_name(4)='pz'
 state_name(5)='s*'
 state_name(6)='dxy'
 state_name(7)='dyz'
 state_name(8)='dzx'
 state_name(9)='dx2y2'
 state_name(10)='dz2r2'


 tb_coup_name(1)='sss'
 tb_coup_name(2)='sps'
 tb_coup_name(3)='pss'
 tb_coup_name(4)='pps'
 tb_coup_name(5)='ppp'
 tb_coup_name(6)='s*ps'
 tb_coup_name(7)='ps*s' 
 tb_coup_name(8)='s*s*s'
 tb_coup_name(9)='s*ss'
 tb_coup_name(10)='ss*s'
 tb_coup_name(11)='sds'
 tb_coup_name(12)='dss'
 tb_coup_name(13)='s*ds'
 tb_coup_name(14)='ds*s' 
 tb_coup_name(15)='pds'
 tb_coup_name(16)='dps'
 tb_coup_name(17)='pdp'
 tb_coup_name(18)='dpp'
 tb_coup_name(19)='dds'
 tb_coup_name(20)='ddp'
 tb_coup_name(21)='ddd'
 $end
 
#                es        ep         ep           ep         ese      dxy 	dyz	dzx     dx2y2    dz2r2
 $tb_onsite_elements
'Si' 1     -2.038566     5.066972     5.066972     5.066972     19.969862  14.832327        14.832327        14.832327        14.832327        14.832327  
'Si' 2     -2.038566     5.066972     5.066972     5.066972     19.969862  14.832327        14.832327        14.832327        14.832327        14.832327  
 $end

# crude approximation for inclusion of spin-orbit case...
# shift p-energies by spin-p-coupling as given below and set above  relativistic=.true.

#          p        d
 $tb_spin_orbit_couplings
 'Si' 1   0.0147  0.0000 
 'Si' 2   0.0147  0.0000 
 $end

#                       sss     sps      pss       pps        ppp    seps       pses   	s*s*s	 s*ss	  ss*s  	sds     dss    s*ds    ds*s       pds     dps       pdp      dpp    dds      ddp     ddd
 $tb_coupling_elements
  'Si' 1  'Si' 2  1   -1.888537  2.960  2.960  4.365   -1.628   3.534   3.534   -3.693   -1.510 -1.510 -2.534 -2.534 -2.0505 -2.0505  -2.267497  -2.267  2.473  2.473  -1.542   3.606   -1.71566  
$end

 $tb_model_distance
 default_distance_power = 2.d0
 $end

 $distance_dependence
 $end
 
 
 