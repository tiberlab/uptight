# sp3s* model
# P.Vogl, H.P.Hjalmarson, and J.D.Dow, J. Phys. Chem. Sol.  44, 365 (1983)
# note the following transformations of tb-couplings from cartesian basis 
# to molecular basis
# sss = 0.25 * v(s,s),  sps = 0.25* sqrt(3) * v(s,p)  
# pps = 0.25* (v(x,x) + 2*v(x,y)), ppp = 0.25* (v(x,x) - v(x,y))
##  coordinate cartesiani reali per la base  !!!!
# modello sp3 !!!!!!!! da ROBERTSON  e Koslowski a Di Carlo !! (3/8/2000)
# prova strain


 $subject
 compound_name = 'SiO2'
 comment = 'sp3'
 $end

 $lattice
 prim1 = 
    3.7000      3.7000      0.0000 
 prim2 = 
    0.0000      3.7000      3.7000 
 prim3 =
    3.7000      0.0000      3.7000

 fuzzyequal=.true.
 accuracy = 5.0D-3
 prim_lattice_cosy=.false.

 basis_name(1)='Si'
 basis_name(2)='Si'
 basis_name(3)='Ox'
 basis_name(4)='Ox'
 basis_name(5)='Ox'
 basis_name(6)='Ox'
 
 basis =
     0.0    0.0     0.0
     1.85   1.85    1.85
     0.925  0.925   0.925
     2.775  0.925   2.775
     0.925  2.775   2.775
     2.775  2.775   0.925 
 $end

 $states_and_couplings

 relativistic=.false.

 state_name(1)='s'
 state_name(2)='px'
 state_name(3)='py'
 state_name(4)='pz'

 tb_coup_name(1)='sss'
 tb_coup_name(2)='sps'
 tb_coup_name(3)='pss'
 tb_coup_name(4)='pps'
 tb_coup_name(5)='ppp'
 $end
 
#                es        ep         ep           ep   
 $tb_onsite_elements 
