# Tight binding parameters - sp3 model
# From Grosso-Petramacchi PRB 51, 16772 (1995)
# This parameterization is not fully compatible with the 
# 2-center approx. 
# It is valid along the GX line, but not the LG line.

material type = 'simple'

lattice type = 'face centered cubic'

lattice parameters =  5.43D0   5.43D0   5.43D0

internal strain parameter = 0.00D0

basis type = 'diamond'

number of ions = 1
ions = 'Si'
Si valence = 4 

Si b_d parameter = 0.0D0
# states

number of spin-orbit parameters per ion = 1 1

Si spin orbit
p 0.0147D0


number of orbitals per ion = 2

Si onsite
's'     -4.0350D0  1
'p'      1.0444D0  3

Si offset = 0.000D0


# TB couplings

number of pairs = 2

pair 1 = 'Si' 'Si'  5 1
pair 2 = 'Si' 'Si'  5 2

Si Si coupling 1
'sss'     -2.0662D0    4.37D0 
'sps'      2.0850D0    3.46D0
'pss'      2.0850D0    3.46D0
'pps'      3.1837D0    2.72D0
'ppp'     -0.9488D0    4.51D0

Si Si pair reference distance 1 = 2.3513D0

